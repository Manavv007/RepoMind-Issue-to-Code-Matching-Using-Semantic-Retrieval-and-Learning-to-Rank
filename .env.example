# RepoMind environment configuration (example).
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# All variables use the REPOMIND_ prefix and are optional (sane defaults exist).

# --- General ---------------------------------------------------------------
REPOMIND_APP_NAME=RepoMind
REPOMIND_ENVIRONMENT=development
REPOMIND_LOG_LEVEL=INFO

# --- Storage / data paths --------------------------------------------------
# Directory for indexes, caches, and disposable checkouts.
REPOMIND_DATA_DIR=./data
# SQLAlchemy-style DB URL for metadata and analysis records.
REPOMIND_DATABASE_URL=sqlite:///./data/repomind.db

# --- Ingestion -------------------------------------------------------------
# Optional GitHub token for higher rate limits / authorized private repos.
# NEVER commit a real token.
REPOMIND_GITHUB_TOKEN=
REPOMIND_MAX_REPO_SIZE_MB=500
REPOMIND_MAX_FILE_SIZE_KB=1024
REPOMIND_MAX_FILES=20000
REPOMIND_CLONE_TIMEOUT_SECONDS=600
REPOMIND_MAX_INDEX_SECONDS=900

# --- Retrieval -------------------------------------------------------------
REPOMIND_DEFAULT_TOP_K=10
REPOMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REPOMIND_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Optional LLM provider (Phase 9) --------------------------------------
# Leave blank to disable diagnosis/patch proposal.
REPOMIND_LLM_PROVIDER=
REPOMIND_LLM_API_KEY=
